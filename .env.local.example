# Site / app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SCHEDULE_POLL_MS=30000

# Upstream APIs (defaults apply when unset)
MTR_NEXT_TRAIN_API_URL=https://rt.data.gov.hk/v1/transport/mtr/getSchedule.php
LR_NEXT_TRAIN_API_URL=https://rt.data.gov.hk/v1/transport/mtr/lrt/getSchedule

# Schedule cache (seconds)
SCHEDULE_REVALIDATE_SECONDS=30
SCHEDULE_S_MAXAGE_SECONDS=30
SCHEDULE_STALE_WHILE_REVALIDATE_SECONDS=60

# Security
ALERT_URL_ALLOWED_HOSTS=mtr.com.hk
FRESH_COOLDOWN_MS=0

# Rate limits (consumed when Upstash is configured)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
FRESH_RATE_LIMIT_REQUESTS=30
FRESH_RATE_LIMIT_WINDOW_MS=60000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional)
VERCEL_URL=http://localhost:3000
CI=false
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
